#admin-tags-index
  h2.h2 Review Tags

  - flash.each do |key, message|
    div class="alert alert-#{key}"
      = message

  nav.nav.flex-row
    = link_to "all", admin_tags_path, class: 'nav-link'
    = link_to "unconfirmed", admin_tags_path(status: "unconfirmed"), class: 'nav-link'
    = link_to "approved", admin_tags_path(status: "approved"), class: 'nav-link'
    = link_to "spam", admin_tags_path(status: "spam"), class: 'nav-link'

  - if @project
    .mb-2.alert.alert-info.d-flex.align-items-center.justify-content-between
      span
        | プロジェクト「#{@project.title_with_owner_name}」で絞り込み中
      = link_to "絞り込みを解除", admin_tags_path(status: @status), class: 'btn btn-sm btn-outline-secondary'

  .mb-3
    - if @tags.length.positive?
      - batch_label = @project ? "このプロジェクトの未確認を一括スパムにする" : "すべての未確認を一括スパムにする"
      = button_to batch_label, admin_tags_spam_batch_path(before: @tags.first.created_at, status: @status, page: params[:page], project_id: params[:project_id]), method: :post, form: { data: { turbo: true, turbo_confirm: "スパムにしますか？" } }
    - else
      = button_to "すべての未確認を一括スパムにする", "#", disabled: true

  table.table.tags-table
    thead
      tr
        th.status
          | ステータス
        th.name
          | タグ名
        th.tagger
          | 投稿者
        th.project-name
          | プロジェクト名
        th.management
          | 操作
    tbody
    - @tags.each do |tag|
      tr.tag
        td.status
          = tag.status
        td.name
          = tag.name
        td.tagger
          = tag.user.name
        td.project-name
          = link_to "#{tag.project.owner.name}/#{tag.project.title}", admin_tags_path(project_id: tag.project_id, status: @status)
        td.management
          - if tag.unconfirmed?
            = button_to "承認", admin_tag_approval_path(tag, status: @status, page: params[:page], project_id: params[:project_id]), method: :post, form: { data: { turbo: true } }
          - if tag.approved?
            = button_to "未承認に戻す", admin_tag_approval_path(tag, status: @status, page: params[:page], project_id: params[:project_id]), method: :delete, form: { data: { turbo: true } }
          - if tag.spam?
            = button_to "未承認に戻す", admin_tag_spam_path(tag, status: @status, page: params[:page], project_id: params[:project_id]), method: :delete, form: { data: { turbo: true } }

  = paginate(@tags)
