#admin-annotations-index
  h2.h2 Review Annotations

  - flash.each do |key, message|
    div class="alert alert-#{key}"
      = message

  nav.nav.flex-row
    = link_to "all", admin_annotations_path, class: 'nav-link'
    = link_to "unconfirmed", admin_annotations_path(status: "unconfirmed"), class: 'nav-link'
    = link_to "approved", admin_annotations_path(status: "approved"), class: 'nav-link'
    = link_to "spam", admin_annotations_path(status: "spam"), class: 'nav-link'

  - if @project
    .mb-2.alert.alert-info.d-flex.align-items-center.justify-content-between
      span
        | プロジェクト「#{@project.title_with_owner_name}」で絞り込み中
      = link_to "絞り込みを解除", admin_annotations_path(status: @status), class: 'btn btn-sm btn-outline-secondary'

  .mb-3
    - if @annotations.length.positive?
      - batch_label = @project ? "このプロジェクトの未確認を一括スパムにする" : "すべての未確認を一括スパムにする"
      = button_to batch_label, admin_annotations_spam_batch_path(before: @annotations.first.created_at, status: @status, page: params[:page], project_id: params[:project_id]), method: :post, form: { data: { turbo: true, turbo_confirm: "スパムにしますか？" } }
    - else
      = button_to "すべての未確認を一括スパムにする", "#", disabled: true

  table.table.annotations-table
    thead
      tr
        th.status
          | ステータス
        th.body
          | 内容
        th.project-name
          | プロジェクト名
        th.management
          | 操作
    tbody
    - @annotations.each do |annotation|
      tr.card
        td.status
          = annotation.status
        td.body
          = annotation.title
          - if annotation.description.present?
            p.text-muted.small
              = truncate(annotation.description.to_s, length: 80)
        td.project-name
          - if (project = annotation.project)
            = link_to "#{project.owner.name}/#{project.title}", admin_annotations_path(project_id: project.id, status: @status)
          - else
            span.text-muted 所属プロジェクトなし
        td.management
          - if annotation.unconfirmed?
            = button_to "承認", admin_annotation_approval_path(annotation, status: @status, page: params[:page], project_id: params[:project_id]), method: :post, form: { data: { turbo: true } }
          - if annotation.approved?
            = button_to "未承認に戻す", admin_annotation_approval_path(annotation, status: @status, page: params[:page], project_id: params[:project_id]), method: :delete, form: { data: { turbo: true } }
          - if annotation.spam?
            = button_to "未承認に戻す", admin_annotation_spam_path(annotation, status: @status, page: params[:page], project_id: params[:project_id]), method: :delete, form: { data: { turbo: true } }

  = paginate(@annotations)
