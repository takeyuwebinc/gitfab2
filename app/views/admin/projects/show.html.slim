#admin-projects-show
  h2.h2 Manage Project

  h3.h3
    = @project.title_with_owner_name

  p
    = link_to(project_path(@project.owner, @project), project_path(@project.owner, @project))

  table.table
    tr
      th
        'プロジェクト名
      td
        = @project.name
    tr
      th
        'オーナー
      td
        = @project.owner.name
    tr
      th
        '作成日時
      td
        = @project.created_at
    tr
      th
        'プライベート
      td
        = @project.is_private ? 'はい' : 'いいえ'
    tr
      th
        '削除済み
      td
        = @project.is_deleted ? 'はい' : 'いいえ'
    tr
      th
        'フォーク元
      td
        = @project.original ? link_to(@project.original.title_with_owner_name, [:admin, @project]) : '-'

  h3.h3.mt-3 このプロジェクトのモデレーション
  ul
    li
      = link_to 'プロジェクトコメント', admin_project_comments_path(project_id: @project.id)
    li
      = link_to 'カードコメント', admin_card_comments_path(project_id: @project.id)
    li
      = link_to 'Usage', admin_usages_path(project_id: @project.id)
    li
      = link_to 'Annotation', admin_annotations_path(project_id: @project.id)
    li
      = link_to 'タグ', admin_tags_path(project_id: @project.id)

  .mt-3
    = button_to('スパム認定', admin_project_path(@project.id), method: :delete, class: 'btn btn-danger btn-lg', data: {confirm: '本当にスパム認定しますか？'})
